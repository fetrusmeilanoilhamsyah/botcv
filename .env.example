# ─── BOT ──────────────────────────────────────────────────────────────────────
BOT_TOKEN=isi_token_bot_telegram_dari_botfather
ADMIN_IDS=123456789,987654321
ADMIN_CONTACT=@username_admin
GROUP_LINK=https://t.me/link_grup_anda
HARGA_MEMBER=Rp 5.000 / minggu
TUTORIAL_LINK=https://t.me/link_tutorial_anda

# ─── PAKASIR PAYMENT GATEWAY (QRIS OTOMATIS) ──────────────────────────────────
# Set PAKASIR_ENABLED=true untuk aktifkan pembayaran QRIS otomatis.
# Jika false, bot fallback ke mode manual (user hubungi admin).
PAKASIR_ENABLED=false

# Dapatkan SLUG dan API_KEY dari https://app.pakasir.com → Project Settings
PAKASIR_SLUG=your-project-slug
PAKASIR_API_KEY=your-api-key

# Sandbox mode: true = testing (tidak tarik uang beneran), false = production
PAKASIR_SANDBOX=true

# Secret untuk verifikasi HMAC webhook dari Pakasir.
# Generate dengan: python3 -c "import secrets; print(secrets.token_hex(32))"
# Daftarkan secret yang sama di dashboard Pakasir.
# Jika kosong: webhook hanya divalidasi via order_id+amount (kurang aman).
PAKASIR_WEBHOOK_SECRET=

# ─── SERVER PORTS ─────────────────────────────────────────────────────────────
# WEBHOOK_PORT: port untuk menerima callback dari Pakasir (buka di firewall!)
# HEALTH_PORT:  port untuk endpoint /health (monitoring)
# Pastikan WEBHOOK_PORT != HEALTH_PORT
WEBHOOK_PORT=8081
HEALTH_PORT=8080
